        {
          "name": "Sample News Feed",
          "description": "Sample news headlines in RSS format.",
          "method": "GET",
          "path": "/api/rssFeeds/sampleNews.xml",
          "url": "https://trleahy.github.io/API-Endpoints/api/rssFeeds/sampleNewsFeed.xml"
        },
        {
          "name": "Test Feed",
          "description": "Test feed in RSS format.",
          "method": "GET",
          "path": "/api/rssFeeds/testFeed.xml",
          "url": "https://trleahy.github.io/API-Endpoints/api/rssFeeds/testFeed.xml"
        }
      ]
    },
    {
      "id": "timezones",
