    {
      "id": "assets",
      "name": "Assets",
      "endpoints": [
        {
          "name": "Assets",
          "description": "Returns specified asset.",
          "method": "GET",
          "path": "/api/assets/<assetName>",
          "url": "https://trleahy.github.io/API-Endpoints/api/assets/<assetName>"
        }
      ]
    },
    {
      "id": "rss",
      "name": "RSS Feeds",
